    TabOrder = 0
  end
  object ResetButton: TButton
    Left = 208
    Top = 24
    Width = 112
    Height = 44
    Caption = 'Reset'
    OnClick = ResetButtonClick
    TabOrder = 1
  end
  object SaveFileButton: TButton
    Left = 600
    Top = 24
    Width = 100
    Height = 44
    Caption = 'Save file'
    OnClick = SaveFileButtonClick
    TabOrder = 2
  end
  object SaveAgainButton: TButton
    Left = 480
    Top = 24
    Width = 100
    Height = 44
    Caption = 'Save again'
    Enabled = False
    OnClick = SaveAgainButtonClick
    TabOrder = 3
  end
  object AtomicRenameCheckBox: TCheckBox
    Left = 580
    Top = 82
    Width = 130
    Height = 30
    Caption = 'Atomic rename'
    TabOrder = 4
  end
  object FailRenameCheckBox: TCheckBox
    Left = 580
    Top = 112
    Width = 130
    Height = 30
